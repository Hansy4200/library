@model List<Member>
@{
    ViewData["Title"] = "Members";
}

<div class="book-inventory-page">

    <div class="book-page-header">
        <div>
            <span class="book-eyebrow">LIBRARY MEMBERS</span>
            <h1>Members</h1>
            <p>Everyone registered with the library.</p>
        </div>
        <a asp-action="Create" class="book-add-button">+ Add a member</a>
    </div>

    <div class="book-summary">
        <div class="book-summary-icon">👥</div>
        <div>
            <strong>@Model.Count</strong>
            <span>members registered</span>
        </div>
    </div>

    <section class="book-table-section">

        <div class="book-table-heading">
            <div>
                <h2>All members</h2>
                <p>Search by name, email, or type.</p>
            </div>
            <span class="book-record-count" id="bookCount">@Model.Count RECORDS</span>
        </div>

        <div class="book-toolbar">
            <label class="book-search-box">
                <span>⌕</span>
                <input type="text" id="bookSearch" placeholder="Search by name, email, or type" autocomplete="off" />
            </label>
            <button type="button" class="book-clear-button" id="bookClear">Clear</button>
        </div>

        @if (Model.Count == 0)
        {
            <div class="book-empty-state">
                <div>👥</div>
                <h3>No members yet</h3>
                <p>Register the first member to get started.</p>
                <a asp-action="Create" class="book-add-button">+ Add a member</a>
            </div>
        }
        else
        {
            <div class="book-table-wrapper">
                <table class="book-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>FULL NAME</th>
                            <th>EMAIL</th>
                            <th>JOIN DATE</th>
                            <th>TYPE</th>
                            <th class="book-actions-heading">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            var searchText = $"{m.FullName} {m.Email} {m.MemberType}".ToLowerInvariant();
                            <tr class="book-row" data-search="@searchText">
                                <td class="book-id">@m.MemberId</td>
                                <td>
                                    <div class="book-title-cell">
                                        <span class="book-row-icon">👤</span>
                                        <strong>@m.FullName</strong>
                                    </div>
                                </td>
                                <td>@(m.Email ?? "—")</td>
                                <td>@m.JoinDate.ToString("yyyy-MM-dd")</td>
                                <td><span class="book-category-tag">@m.MemberType</span></td>
                                <td>
                                    <div class="book-action-buttons">
                                        <a asp-action="Edit" asp-route-id="@m.MemberId" class="book-edit-button">✎ Edit</a>
                                        <a asp-action="Delete" asp-route-id="@m.MemberId" class="book-delete-button">🗑 Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="book-no-results" id="bookNoResults" hidden>
                    <span>🔍</span>
                    <h3>No members found</h3>
                    <p>Try a different name, email, or type, or clear the search.</p>
                </div>
            </div>

            <div class="book-table-footer">
                <span>Showing all registered members</span>
                <span>GREENLEAF LIBRARY</span>
            </div>
        }
    </section>
</div>

<script>
    (function () {
        var input = document.getElementById('bookSearch');
        var clear = document.getElementById('bookClear');
        var count = document.getElementById('bookCount');
        var none = document.getElementById('bookNoResults');
        var rows = Array.prototype.slice.call(document.querySelectorAll('.book-row'));
        if (!input || !count) return;

        function apply() {
            var q = input.value.trim().toLowerCase();
            var shown = 0;
            rows.forEach(function (r) {
                var match = !q || r.getAttribute('data-search').indexOf(q) !== -1;
                r.hidden = !match;
                if (match) shown++;
            });
            count.textContent = q ? shown + ' OF ' + rows.length + ' RECORDS' : rows.length + ' RECORDS';
            if (none) none.hidden = shown !== 0 || rows.length === 0;
        }

        input.addEventListener('input', apply);
        clear.addEventListener('click', function () { input.value = ''; apply(); input.focus(); });
    })();
</script>