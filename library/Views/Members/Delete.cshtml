@model Member
@{
    ViewData["Title"] = "Delete a member";
}

<div class="book-form-page">

    <div class="book-form-breadcrumb">
        <a asp-action="Index">Members</a>
        <span>/</span>
        <span>Delete a member</span>
    </div>

    <div class="book-delete-card">
        <div class="delete-warning-icon">!</div>
        <h2>Delete this member?</h2>
        <p class="delete-warning-text">
            This can't be undone. A member who still has loans can't be deleted.
        </p>

        <div class="delete-book-details">
            <div class="delete-book-cover">👤</div>
            <div class="delete-book-info">
                <span>MEMBER #@Model.MemberId</span>
                <h3>@Model.FullName</h3>
                <p>Email: <strong>@(Model.Email ?? "—")</strong></p>
                <p>Type: <strong>@Model.MemberType</strong></p>
                <p>Joined: <strong>@Model.JoinDate.ToString("yyyy-MM-dd")</strong></p>
            </div>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.MemberId" method="post">
            <div asp-validation-summary="ModelOnly" class="book-validation-summary"></div>
            <div class="book-delete-actions">
                <a asp-action="Index" class="book-cancel-btn">Cancel</a>
                <button type="submit" class="book-confirm-delete-btn">Delete member</button>
            </div>
        </form>
    </div>
</div>