@model Book
@{
    ViewData["Title"] = "Delete a book";
}

<div class="book-form-page">

    <div class="book-form-breadcrumb">
        <a asp-action="Index">Books</a>
        <span>/</span>
        <span>Delete a book</span>
    </div>

    <div class="book-delete-card">
        <div class="delete-warning-icon">!</div>
        <h2>Delete this book?</h2>
        <p class="delete-warning-text">
            This can't be undone. Any loans of this book are deleted with it.
        </p>

        <div class="delete-book-details">
            <div class="delete-book-cover">📖</div>
            <div class="delete-book-info">
                <span>BOOK #@Model.BookId</span>
                <h3>@Model.Title</h3>
                <p>Category: <strong>@(string.IsNullOrWhiteSpace(Model.Category) ? "—" : Model.Category)</strong></p>
                <p>Price: <strong>@(Model.Price is null ? "—" : "₱" + Model.Price.Value.ToString("N2"))</strong></p>
            </div>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.BookId" method="post">
            <div class="book-delete-actions">
                <a asp-action="Index" class="book-cancel-btn">Cancel</a>
                <button type="submit" class="book-confirm-delete-btn">Delete book</button>
            </div>
        </form>
    </div>
</div>