@model Book
@{
    ViewData["Title"] = "Add a book";
}

<div class="book-form-page">

    <div class="book-form-breadcrumb">
        <a asp-action="Index">Books</a>
        <span>/</span>
        <span>Add a book</span>
    </div>

    <div class="book-form-heading">
        <h1>Add a book</h1>
        <p>Add a new title to the catalogue.</p>
    </div>

    <div class="book-form-card">
        <div class="book-form-card-heading">
            <div class="book-form-icon">📖</div>
            <div>
                <h2>Book details</h2>
                <p>Title is required. Category and price are optional.</p>
            </div>
        </div>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="book-validation-summary"></div>

            <div class="book-form-fields">
                <div class="book-form-group">
                    <label asp-for="Title">Book title</label>
                    <input asp-for="Title" class="book-form-input" placeholder="e.g. Noli Me Tangere" />
                    <span asp-validation-for="Title" class="book-validation-message"></span>
                </div>

                <div class="book-form-group">
                    <label asp-for="Category">Category</label>
                    <select asp-for="Category" class="book-form-input">
                        <option value="">(none)</option>
                        <option>Classic</option>
                        <option>Fiction</option>
                        <option>Poetry</option>
                        <option>Reference</option>
                        <option>Textbook</option>
                    </select>
                </div>

                <div class="book-form-group">
                    <label asp-for="Price">Price</label>
                    <div class="book-price-input">
                        <span>₱</span>
                        <input asp-for="Price" class="book-form-input" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Price" class="book-validation-message"></span>
                </div>
            </div>

            <div class="book-form-actions">
                <a asp-action="Index" class="book-cancel-btn">Cancel</a>
                <button type="submit" class="book-save-btn">Save book</button>
            </div>
        </form>
    </div>
</div>