@model Note
@{
    ViewData["Title"] = "Delete a note";
}

<div class="book-form-page">

    <div class="book-form-breadcrumb">
        <a asp-action="Index">Notes</a>
        <span>/</span>
        <span>Delete a note</span>
    </div>

    <div class="book-delete-card">
        <div class="delete-warning-icon">!</div>
        <h2>Delete this note?</h2>
        <p class="delete-warning-text">This can't be undone.</p>

        <div class="delete-book-details">
            <div class="delete-book-cover">📝</div>
            <div class="delete-book-info">
                <span>NOTE #@Model.NoteId</span>
                <h3>@Model.Title</h3>
                <p>@(string.IsNullOrWhiteSpace(Model.Body) ? "No body" : Model.Body)</p>
                <p>Created: <strong>@Model.CreatedOn.ToString("yyyy-MM-dd")</strong></p>
            </div>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.NoteId" method="post">
            <div asp-validation-summary="ModelOnly" class="book-validation-summary"></div>
            <div class="book-delete-actions">
                <a asp-action="Index" class="book-cancel-btn">Cancel</a>
                <button type="submit" class="book-confirm-delete-btn">Delete note</button>
            </div>
        </form>
    </div>
</div>