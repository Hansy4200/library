@model Note
@{
    ViewData["Title"] = "Add a note";
}

<div class="book-form-page">

    <div class="book-form-breadcrumb">
        <a asp-action="Index">Notes</a>
        <span>/</span>
        <span>Add a note</span>
    </div>

    <div class="book-form-heading">
        <h1>Add a note</h1>
        <p>Save a reminder for the library team.</p>
    </div>

    <div class="book-form-card">
        <div class="book-form-card-heading">
            <div class="book-form-icon">📝</div>
            <div>
                <h2>Note details</h2>
                <p>Title is required. Body is optional.</p>
            </div>
        </div>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="book-validation-summary"></div>

            <div class="book-form-fields">
                <div class="book-form-group">
                    <label asp-for="Title">Title</label>
                    <input asp-for="Title" class="book-form-input" placeholder="e.g. Order new textbooks" />
                    <span asp-validation-for="Title" class="book-validation-message"></span>
                </div>

                <div class="book-form-group">
                    <label asp-for="Body">Body</label>
                    <textarea asp-for="Body" class="book-form-input" rows="5"
                              style="height:auto; min-height:130px; padding:12px 14px; resize:vertical"
                              placeholder="Add details (optional)"></textarea>
                    <span asp-validation-for="Body" class="book-validation-message"></span>
                </div>
            </div>

            <div class="book-form-actions">
                <a asp-action="Index" class="book-cancel-btn">Cancel</a>
                <button type="submit" class="book-save-btn">Save note</button>
            </div>
        </form>
    </div>
</div>