@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) =>
        string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Greenleaf Library</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/library.styles.css" asp-append-version="true" />
</head>
<body>
    <script>
            try { if (localStorage.getItem('theme') === 'dark') document.body.classList.add('dark-mode'); } catch (e) { }
    </script>

    <header class="main-header">
        <div class="nav-container">
            <a class="logo" asp-controller="Home" asp-action="Index">
                <span class="logo-mark">G</span>
                GREENLEAF
            </a>

            <nav class="main-nav">
                <a class="@Active("Home")" asp-controller="Home" asp-action="Index">Home</a>
                <a class="@Active("Books")" asp-controller="Books" asp-action="Index">Books</a>
                <a class="@Active("Members")" asp-controller="Members" asp-action="Index">Members</a>
                <a class="@Active("Notes")" asp-controller="Notes" asp-action="Index">Notes</a>
            </nav>

            <button type="button" class="theme-toggle" id="themeToggle">🌙 Dark</button>
        </div>
    </header>

    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div>
            <strong>GREENLEAF LIBRARY</strong>
            <span>&copy; 2026 - Library Management System</span>
        </div>
        <a asp-controller="Home" asp-action="Privacy">Privacy</a>
    </footer>

    <script>
            (function () {
                var body = document.body, btn = document.getElementById('themeToggle');
                function label() { btn.textContent = body.classList.contains('dark-mode') ? '☀ Light' : '🌙 Dark'; }
                label();
                btn.addEventListener('click', function () {
                    body.classList.toggle('dark-mode');
                    try { localStorage.setItem('theme', body.classList.contains('dark-mode') ? 'dark' : 'light'); } catch (e) { }
                    label();
                });
            })();
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>